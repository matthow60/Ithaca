# Shared by patcher/ and the dashboard. Copy to .env (never commit .env).
# --- MongoDB (change streams need a replica set, e.g. Atlas or `mongod --replSet rs0`) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hackuta
MONGODB_COLLECTION=incidents

# --- GitHub ---
# Fine-grained token with Contents: read/write and Pull requests: read/write on the target repo
GH_TOKEN=
TARGET_OWNER=your-github-user
TARGET_REPO=your-target-app

# --- Target app ---
# Command that boots the target app from the repo root. It must listen on process.env.PORT.
TARGET_START_CMD=node server/index.js
# Folder (relative to repo root) where `npm ci` runs. Defaults to the repo root.
TARGET_SERVER_DIR=server

# --- Patcher ---
PORT=4000
# mock = hand-written fixes from patches/<file>; llm = AI writes the fix
LLM_MODE=mock

# --- LLM (any OpenAI-compatible endpoint; used when LLM_MODE=llm) ---
# Key: https://aistudio.google.com/apikey (free tier). Pick models your key lists:
#   curl -H "Authorization: Bearer $LLM_API_KEY" $LLM_BASE_URL/models
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
# Fallback on 429/5xx/timeouts. Can be another Gemini model with the same key, or Groq:
#   https://api.groq.com/openai/v1 + a Groq key + e.g. llama-3.3-70b-versatile
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- Dashboard (Next.js, repo root) ---
# Uses MONGODB_* and LLM_* above. Check them with: npm run db:test / npm run llm:test
